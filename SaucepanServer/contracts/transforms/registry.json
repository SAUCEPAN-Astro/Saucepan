{
  "registry_id": "saucepan-transform-registry",
  "version": "1.0.0",
  "standard_system": "johnson_cousins",
  "description": "Passband / filter-family IDs and linear colour/extinction coefficient tables for placing heterogeneous instrumental magnitudes on one campaign standard (#206). Each transform entry carries its own `version`; the loader computes a `content_hash` (sha256 of the canonicalised entry) that callers pin and re-verify before use. Coefficients are AAVSO-style linear colour terms: m_std = m_inst + ZP + T*(CI - CI0) + k*X. Entries marked generic are network defaults, not a per-site solution; a campaign that needs site/epoch accuracy registers its own entry.",
  "references": [
    "AAVSO CCD Photometry Guide (2014)",
    "Jordi, Grebel & Ammon (2006), A&A 460, 339 — SDSS<->JC transforms",
    "Honeycutt (1992), PASP 104, 435 — ensemble differential photometry"
  ],
  "passbands": {
    "JC_U": {"system": "johnson_cousins", "name": "Johnson U"},
    "JC_B": {"system": "johnson_cousins", "name": "Johnson B"},
    "JC_V": {"system": "johnson_cousins", "name": "Johnson V"},
    "JC_Rc": {"system": "johnson_cousins", "name": "Cousins R"},
    "JC_Ic": {"system": "johnson_cousins", "name": "Cousins I"},
    "SLOAN_G": {"system": "sloan", "name": "Sloan g'"},
    "SLOAN_R": {"system": "sloan", "name": "Sloan r'"},
    "SLOAN_I": {"system": "sloan", "name": "Sloan i'"},
    "CLEAR": {"system": "unfiltered", "name": "Clear / luminance (no filter)"},
    "OSC_G": {"system": "osc", "name": "One-shot-colour green channel"},
    "OSC_R": {"system": "osc", "name": "One-shot-colour red channel"},
    "OSC_B": {"system": "osc", "name": "One-shot-colour blue channel"}
